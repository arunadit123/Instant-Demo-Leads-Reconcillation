# Copy this file to .env and fill in the values. Keep .env private (it is git-ignored).

# Calendly personal access token: calendly.com/app/developer (Personal Access Tokens tab)
CALENDLY_TOKEN=

# Routing form URI, e.g. https://api.calendly.com/routing_forms/XXXXXXXX
# Get it by running: python3 daily_calendly_export.py --list-forms
CALENDLY_FORM_URI=

# Gmail sending account and an App Password (Google Account > Security > App passwords)
SMTP_USER=arun.kumar@adit.com
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Where the CSV is emailed
EMAIL_TO=arun.kumar@adit.com
